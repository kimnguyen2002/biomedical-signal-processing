# Matplotlib style shared by every notebook in the book.
# Usage (from a chapter folder):  plt.style.use("../bsp.mplstyle")

# Figure
figure.figsize          : 8, 3.2
figure.dpi              : 110
figure.facecolor        : white
figure.constrained_layout.use : True
savefig.dpi             : 150
savefig.facecolor       : white
savefig.bbox            : tight

# Fonts
font.family             : sans-serif
font.sans-serif         : Helvetica Neue, Helvetica, Arial, DejaVu Sans
font.size               : 10
mathtext.fontset        : stixsans
axes.titlesize          : 11
axes.titleweight        : bold
axes.titlelocation      : left
axes.titlepad           : 8
axes.labelsize          : 10
xtick.labelsize         : 9
ytick.labelsize         : 9
legend.fontsize         : 9

# Ink
text.color              : 0b0b0b
axes.labelcolor         : 2b2b29
xtick.color             : 52514e
ytick.color             : 52514e
axes.edgecolor          : b9b8b2

# Axes and grid (recessive, solid hairlines)
axes.facecolor          : white
axes.linewidth          : 0.8
axes.spines.top         : False
axes.spines.right       : False
axes.grid               : True
axes.axisbelow          : True
grid.color              : e8e7e3
grid.linestyle          : -
grid.linewidth          : 0.7
axes.xmargin            : 0.01
xtick.direction         : out
ytick.direction         : out
xtick.major.size        : 3
ytick.major.size        : 3

# Categorical colour order (validated for colour-vision deficiency on white)
axes.prop_cycle         : cycler('color', ['2a78d6', 'eb6834', '1baf7a', 'eda100', 'e87ba4', '008300', '6250d6', 'e34948'])

# Marks
lines.linewidth         : 1.4
lines.markersize        : 5
patch.linewidth         : 0.8
scatter.edgecolors      : face
image.cmap              : Blues
image.interpolation     : nearest

# Legend
legend.frameon          : False
legend.borderaxespad    : 0.3
legend.handlelength     : 1.8
